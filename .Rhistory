jaccard <- function(a, b) {
intersection = length(intersect(a, b))
union = length(a) + length(b) - intersection
return (intersection/union)
}
# Run jaccard function for each unique pair of pathways
# Return a data frame with columns: pathway1, pathway2, jaccard_index
jaccard_results <- data.frame()
pathway_names <- names(all_pathway_list)
for (i in 1:(length(pathway_names)-1)) {
for (j in (i+1):length(pathway_names)) {
p1 <- sort(c(pathway_names[i], pathway_names[j]))[1]
p2 <- sort(c(pathway_names[i], pathway_names[j]))[2]
jaccard_index <- jaccard(all_pathway_list[[p1]], all_pathway_list[[p2]])
jaccard_results <- rbind(jaccard_results, data.frame(pathway1 = p1, pathway2 = p2, jaccard_index = jaccard_index))
}
}
list_names <- names(all_pathway_list)
combos <- expand.grid(Name1 = list_names, Name2 = list_names, stringsAsFactors = FALSE)
combos <- subset(combos, Name1 != Name2)
# The unique() call below removes (set1, set2) if (set2, set1) already exists
combos <- unique(data.frame(t(apply(combos[c("Name1", "Name2")], 1, sort)), distance = combos$distance))
